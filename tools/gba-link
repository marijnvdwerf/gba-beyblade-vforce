#!/bin/sh

set -eu

ld=
script=
out=
map=
libgcc=
stage=
objects_file=

cleanup_files=
cleanup() {
    for path in $cleanup_files; do
        rm -rf "$path"
    done
}
trap cleanup EXIT HUP INT TERM

objects_file=${TMPDIR:-/tmp}/gba-link-objects.$$
: > "$objects_file"
cleanup_files=$objects_file

append_object() {
    case $1 in
        @*)
            response=${1#@}
            # CMake response files use shell-style whitespace separation. Build
            # paths in this project contain no whitespace, so split accordingly.
            for response_arg in $(tr '\n' ' ' < "$response"); do
                append_object "$response_arg"
            done
            ;;
        *) printf '%s\n' "$1" >> "$objects_file" ;;
    esac
}

while [ "$#" -gt 0 ]; do
    case $1 in
        --ld=*) ld=${1#--ld=} ;;
        --script=*) script=${1#--script=} ;;
        --out=*) out=${1#--out=} ;;
        --map=*) map=${1#--map=} ;;
        --libgcc=*) libgcc=${1#--libgcc=} ;;
        --stage=*) stage=${1#--stage=} ;;
        -T)
            [ "$#" -ge 2 ] || { printf '%s\n' 'gba-link: missing argument for -T' >&2; exit 2; }
            shift
            script=$1
            ;;
        -T*) script=${1#-T} ;;
        --) shift; while [ "$#" -gt 0 ]; do append_object "$1"; shift; done; break ;;
        -*) printf 'gba-link: unsupported linker option: %s\n' "$1" >&2; exit 2 ;;
        *) append_object "$1" ;;
    esac
    shift
done

for required in ld script out map libgcc stage; do
    eval "value=\${$required}"
    [ -n "$value" ] || { printf 'gba-link: missing --%s=\n' "$required" >&2; exit 2; }
done

absolute_path() {
    case $1 in
        /*) printf '%s\n' "$1" ;;
        *) printf '%s/%s\n' "$(pwd)" "$1" ;;
    esac
}

ld=$(absolute_path "$ld")
script=$(absolute_path "$script")
out=$(absolute_path "$out")
map=$(absolute_path "$map")
libgcc=$(absolute_path "$libgcc")
stage=$(absolute_path "$stage")

stage_parent=$(dirname "$stage")
stage_tmp=${stage}.tmp.$$
stage_old=${stage}.old.$$
mkdir -p "$stage_parent"
rm -rf "$stage_tmp" "$stage_old"
mkdir -p "$stage_tmp"
cleanup_files="$cleanup_files $stage_tmp $stage_old"

stage_file() {
    source_path=$1
    destination_path=$2
    mkdir -p "$(dirname "$destination_path")"
    if ! ln "$source_path" "$destination_path" 2>/dev/null; then
        cp -p "$source_path" "$destination_path"
    fi
}

while IFS= read -r object; do
    [ -n "$object" ] || continue
    object=$(absolute_path "$object")
    case $object in
        */CMakeFiles/*.dir/*) relative=${object#*/CMakeFiles/}; relative=${relative#*.dir/} ;;
        *)
            printf 'gba-link: object path does not contain CMakeFiles/<target>.dir/: %s\n' "$object" >&2
            exit 1
            ;;
    esac
    stage_file "$object" "$stage_tmp/$relative"
done < "$objects_file"
stage_file "$libgcc" "$stage_tmp/libgcc.a"

if [ -e "$stage" ]; then
    mv "$stage" "$stage_old"
fi
mv "$stage_tmp" "$stage"
rm -rf "$stage_old"

mkdir -p "$(dirname "$out")" "$(dirname "$map")"
cd "$stage"
exec "$ld" -T "$script" -Map "$map" -o "$out" libgcc.a
