{
    "search.exclude": {
        "**/expected/**": true,
        "**/.claude/**": true,
        "**/build/**": true,
        "**/node_modules/**": true
    },
    "files.watcherExclude": {
        "**/expected/**": true,
        "**/.claude/**": true,
        "**/build/**": true
    },
    "C_Cpp.files.exclude": {
        "**/expected/**": true,
        "**/.claude/**": true,
        "**/build/**": true,
        "**/node_modules/**": true
    },
    "C_Cpp.default.browse.path": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/lib"
    ],
    "C_Cpp.default.browse.limitSymbolsToIncludedHeaders": true
}
